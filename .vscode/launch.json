{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quyu: run the app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Quyu: check results reproduce",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_reproduce.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Quyu: write Excel + PDF results",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/export_results.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
